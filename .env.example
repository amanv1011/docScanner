# =========================================================
# Multi-Document Intelligence Workbench - Environment Config
# =========================================================

# Backend server port
PORT=3001

# Google Gemini API Key
# Recommended: Fast native multi-document reasoning via Google GenAI SDK
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# OpenAI API Key (Alternative)
# If provided without Gemini, uses OpenAI GPT models
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Note: If no API key is supplied, the workbench automatically runs
# in Intelligent Dynamic Mock Fallback Mode with 100% functionality.
