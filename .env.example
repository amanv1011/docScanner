# =========================================================
# Multi-Document Intelligence Workbench - Environment Config
# =========================================================

# Backend server port
PORT=3001

# OpenAI API Key
# Optional: If omitted, empty, or invalid, the backend will automatically
# activate the Intelligent Dynamic Mock Analyzer fallback mode.
OPENAI_API_KEY=

# Preferred OpenAI Model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
